# Postgres connection string. Required: the server refuses to start without it.
#
# Locally:  copy this file to .env  (npm start and npm test read it automatically)
# On Vercel: set DATABASE_URL in Project Settings > Environment Variables
#
# A pooled host (the one ending in -pooler) is recommended for serverless,
# where many short-lived invocations share a small number of connections.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
